#!/usr/bin/env python3
"""Exercise source setup and loader acquisition with local Git/ZIP fixtures."""

import hashlib
import json
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import unittest
import zipfile


PROJECT = Path(__file__).resolve().parents[1]


def run(*args, cwd=None, check=True):
    return subprocess.run(args, cwd=cwd, check=check, capture_output=True, text=True)


class DevelopmentSetupTests(unittest.TestCase):
    def setUp(self):
        self.temporary = tempfile.TemporaryDirectory(prefix="omarchy-development-setup-")
        self.addCleanup(self.temporary.cleanup)
        root = Path(self.temporary.name)
        self.workspace = root / "host with spaces" / "ps4"
        self.project = self.workspace / "omarchy-ps4"
        for name in ("scripts", "manifests", "workspace"):
            (self.project / name).mkdir(parents=True)
        for name in ("setup-workspace", "fetch-ps4-loader"):
            shutil.copy2(PROJECT / "scripts" / name, self.project / "scripts" / name)
        for name in ("README.md", "AGENTS.md"):
            (self.project / "workspace" / name).write_text(f"Template {name}\n")
        sources = []
        for name in ("linux-ps4-kernel", "ps4-uart"):
            source = root / "sources" / name
            source.mkdir(parents=True)
            run("git", "init", "--quiet", "--initial-branch=master", str(source))
            run("git", "config", "user.name", "Setup Test", cwd=source)
            run("git", "config", "user.email", "setup-test@example.invalid", cwd=source)
            (source / "README.md").write_text("Pinned source\n")
            run("git", "add", "README.md", cwd=source)
            run("git", "commit", "--quiet", "-m", "Pinned revision", cwd=source)
            pin = run("git", "rev-parse", "HEAD", cwd=source).stdout.strip()
            (source / "README.md").write_text("Newer source\n")
            run("git", "commit", "--quiet", "-am", "Newer revision", cwd=source)
            sources.append({"directory": name, "url": source.as_uri(), "branch": "master", "commit": pin})
        self.elf = b"\x7fELF test fixture, never executed\n"
        archive = root / "loader.zip"
        with zipfile.ZipFile(archive, "w") as target:
            target.writestr("elf/linux-1024mb.elf", self.elf)
            target.writestr("unrelated-input", "do not extract")
        self.manifest = {
            "schema": 1,
            "repositories": sources,
            "loader": {
                "url": archive.as_uri(),
                "archive_sha256": hashlib.sha256(archive.read_bytes()).hexdigest(),
                "member": "elf/linux-1024mb.elf",
                "elf_size": len(self.elf),
                "elf_sha256": hashlib.sha256(self.elf).hexdigest(),
                "destination": "payloads/ps4-linux-loader/v25/elf/linux-1024mb.elf",
            },
        }
        self.save_manifest()

    def save_manifest(self):
        (self.project / "manifests/development-sources.json").write_text(json.dumps(self.manifest))

    def command(self, name, *args, check=True):
        return run(sys.executable, str(self.project / "scripts" / name), *args, check=check)

    def test_pinned_clone_offline_check_and_existing_work_are_preserved(self):
        self.assertNotEqual(self.command("setup-workspace", "--check", check=False).returncode, 0)
        self.command("setup-workspace")
        self.command("setup-workspace", "--check")
        for source in self.manifest["repositories"]:
            checkout = self.workspace / source["directory"]
            self.assertEqual(run("git", "rev-parse", "HEAD", cwd=checkout).stdout.strip(), source["commit"])
            (checkout / "README.md").write_text("Uncommitted development work\n")
        rules = self.workspace / "AGENTS.md"
        rules.write_text("Custom operator rules\n")
        self.command("setup-workspace")
        for source in self.manifest["repositories"]:
            checkout = self.workspace / source["directory"]
            self.assertEqual((checkout / "README.md").read_text(), "Uncommitted development work\n")
            self.assertEqual(run("git", "rev-parse", "HEAD", cwd=checkout).stdout.strip(), source["commit"])
        self.assertEqual(rules.read_text(), "Custom operator rules\n")

    def test_wrong_origin_and_non_repository_paths_are_refused(self):
        checkout = self.workspace / "linux-ps4-kernel"
        checkout.mkdir()
        sentinel = checkout / "operator-file"
        sentinel.write_text("keep me\n")
        self.assertNotEqual(self.command("setup-workspace", check=False).returncode, 0)
        self.assertEqual(sentinel.read_text(), "keep me\n")
        self.assertFalse((self.workspace / "ps4-uart").exists())
        sentinel.unlink()
        checkout.rmdir()
        self.command("setup-workspace")
        run("git", "remote", "set-url", "origin", "https://example.invalid/unrelated.git", cwd=checkout)
        head = run("git", "rev-parse", "HEAD", cwd=checkout).stdout
        result = self.command("setup-workspace", check=False)
        self.assertNotEqual(result.returncode, 0)
        self.assertIn("Unexpected origin", result.stderr)
        self.assertEqual(run("git", "rev-parse", "HEAD", cwd=checkout).stdout, head)

    def test_loader_extracts_only_verified_input_and_refuses_replacement(self):
        self.command("fetch-ps4-loader")
        target = self.workspace / self.manifest["loader"]["destination"]
        self.assertEqual(target.read_bytes(), self.elf)
        self.assertFalse((self.workspace / "unrelated-input").exists())
        self.command("fetch-ps4-loader")
        target.write_bytes(b"operator's different loader")
        self.assertNotEqual(self.command("fetch-ps4-loader", check=False).returncode, 0)
        self.assertEqual(target.read_bytes(), b"operator's different loader")

    def test_wrong_archive_or_elf_hash_never_installs_input(self):
        target = self.workspace / self.manifest["loader"]["destination"]
        original = self.manifest["loader"]["archive_sha256"]
        self.manifest["loader"]["archive_sha256"] = "0" * 64
        self.save_manifest()
        self.assertNotEqual(self.command("fetch-ps4-loader", check=False).returncode, 0)
        self.assertFalse(target.exists())
        self.manifest["loader"]["archive_sha256"] = original
        self.manifest["loader"]["elf_sha256"] = "0" * 64
        self.save_manifest()
        self.assertNotEqual(self.command("fetch-ps4-loader", check=False).returncode, 0)
        self.assertFalse(target.exists())


if __name__ == "__main__":
    unittest.main()
