  'shadow'
  'sudo'
  'systemd'
  'util-linux'
  'xdg-user-dirs'
  'xdg-utils'
)

backup=('etc/sudoers.d/10-omarchy-ps4-wheel')

source=(
  'omarchy-ps4-prepare-for-owner'
  'omarchy-ps4-provision-owner'
  'omarchy-ps4-finalize-owner'
  'omarchy-ps4-grow-root'
  'omarchy-ps4-provision-owner.service'
  'omarchy-ps4-grow-root.service'
  '20-omarchy-ps4-owner-gate.conf'
  '20-omarchy-ps4-sshd.conf'
  '10-omarchy-ps4-wheel'
  'README.md'
)
