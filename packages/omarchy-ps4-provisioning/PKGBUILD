package() {
  install -Dm755 omarchy-ps4-prepare-for-owner \
    "$pkgdir/usr/bin/omarchy-ps4-prepare-for-owner"
  install -Dm755 omarchy-ps4-provision-owner \
    "$pkgdir/usr/bin/omarchy-ps4-provision-owner"
  install -Dm755 omarchy-ps4-finalize-owner \
    "$pkgdir/usr/bin/omarchy-ps4-finalize-owner"
  install -Dm755 omarchy-ps4-grow-root \
    "$pkgdir/usr/bin/omarchy-ps4-grow-root"
  install -Dm644 omarchy-ps4-provision-owner.service \
    "$pkgdir/usr/lib/systemd/system/omarchy-ps4-provision-owner.service"
  install -Dm644 omarchy-ps4-grow-root.service \
    "$pkgdir/usr/lib/systemd/system/omarchy-ps4-grow-root.service"
  install -Dm644 20-omarchy-ps4-owner-gate.conf \
    "$pkgdir/usr/lib/systemd/system/lightdm.service.d/20-omarchy-ps4-owner-gate.conf"
  install -Dm644 20-omarchy-ps4-sshd.conf \
    "$pkgdir/etc/ssh/sshd_config.d/20-omarchy-ps4.conf"
  install -Dm440 10-omarchy-ps4-wheel \
    "$pkgdir/etc/sudoers.d/10-omarchy-ps4-wheel"
  install -Dm644 README.md \
    "$pkgdir/usr/share/doc/omarchy-ps4-provisioning/README.md"
