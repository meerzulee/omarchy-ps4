#!/bin/bash

set -uo pipefail

status_line() {
  local label=$1 state=$2 detail=${3:-}
  printf '%-14s %-12s %s\n' "$label" "$state" "$detail"
}

printf 'Omarchy PS4 compatibility status\n\n'

kernel=$(uname -r)
case "$kernel" in
  *-ps4-*) status_line kernel working "$kernel" ;;
  *) status_line kernel unknown "$kernel" ;;
esac

if [[ -r /sys/class/drm/card0-HDMI-A-1/status ]]; then
  connector=$(</sys/class/drm/card0-HDMI-A-1/status)
  mesa_compat=${AMD_DEBUG:-unset}
  if [[ $connector == connected && $mesa_compat == *notiling* ]]; then
    display_state=working
  else
    display_state=check
  fi
  status_line display "$display_state" \
    "HDMI-A-1 $connector; legacy DCE8, AMD_DEBUG=$mesa_compat"
else
  status_line display unknown 'HDMI connector state unavailable'
fi

if command -v glxinfo >/dev/null 2>&1; then
  renderer=$(glxinfo -B 2>/dev/null | sed -n 's/^[[:space:]]*OpenGL renderer string: //p' | head -n1)
  status_line OpenGL "$([[ -n $renderer ]] && printf working || printf check)" "${renderer:-renderer unavailable}"
else
  status_line OpenGL unknown 'install mesa-utils for renderer evidence'
fi

if command -v nmcli >/dev/null 2>&1; then
  network=$(nmcli -t -f DEVICE,TYPE,STATE device 2>/dev/null | \
    awk -F: '$2 == "wifi" && $3 == "connected" { print $1; exit }')
  wifi=$(nmcli -t -f DEVICE,TYPE device 2>/dev/null | \
    awk -F: '$2 == "wifi" { print $1; exit }')
  if [[ -n $network ]]; then
    status_line network working "$network connected"
  elif [[ -n $wifi ]]; then
    status_line network ready "$wifi detected; choose a network from the top bar"
  else
    status_line network check 'no NetworkManager Wi-Fi interface detected'
  fi
else
  status_line network unknown 'NetworkManager CLI unavailable'
fi

if command -v wpctl >/dev/null 2>&1 && wpctl status >/dev/null 2>&1; then
  status_line audio testing 'PipeWire is reachable; HDMI audio is not yet accepted'
else
  status_line audio unsupported 'no accepted HDMI audio path'
fi

status_line Vulkan testing 'package present does not imply a working PS4 Vulkan path'
status_line video-decode unsupported 'UVD/VA-API has not passed its hardware gate'
status_line suspend unsupported 'PS4 power transitions are blocked'
status_line nightlight unsupported 'gamma LUT operation can black out DCE8 HDMI'
status_line internal-SATA blocked 'automatic probing is disabled after I/O failures'

if [[ -r /var/lib/omarchy-ps4/release-state ]]; then
  update_policy=$(sed -n 's/^update_policy=//p' /var/lib/omarchy-ps4/release-state | head -n1)
  status_line updates managed "${update_policy:-release manifest required}"
fi

printf '\nCollect evidence with: omarchy-ps4-probe --experiment NAME\n'
