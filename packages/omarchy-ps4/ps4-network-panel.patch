+function findWifiStationDevice(devices, wifiType, stationMode, accessPointMode) {
+  var values = devices || []
+  var fallback = null
+
+  for (var i = 0; i < values.length; i++) {
+    var device = values[i]
+    if (!device || device.type !== wifiType) continue
+
+    var name = String(device.name || "")
+    var stationInterface = /^wl/i.test(name)
+    if (device.mode === accessPointMode || /^ap[0-9]+$/i.test(name)) continue
+    if (device.mode !== stationMode && !stationInterface) continue
+
+    if (device.connected) return device
+    if (!fallback) fallback = device
+  }
+
+  return fallback
+}
