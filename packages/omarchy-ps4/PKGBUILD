# Maintainer: Omarchy PS4 contributors

pkgname=omarchy-ps4
pkgver=4.0.0
pkgrel=7
pkgdesc='Pinned Omarchy Quattro runtime adapted for PlayStation 4 Linux'
arch=('any')
url='https://github.com/meerzulee/omarchy-ps4'
license=('MIT')
provides=('omarchy')
conflicts=('omarchy' 'omarchy-dev')

_commit=f0020448ca87329199de7cb12f2015ebc4a3e5e7
_probe_sha256=f6638a914ee13b5a34803cc5b2727d7df27e0788694653f3c6f724f6298f7fa7

depends=(
  'fakeroot'
  'git'
  'gnome-keyring'
  'gum'
  'hyprland'
  'jq'
  'omarchy-ps4-settings=4.0.0-6'
  'pacman-contrib'
  'perl'
  'pipewire'
  'quickshell'
  'ttf-jetbrains-mono-nerd-basic'
  'thunar'
  'uwsm'
  'wireplumber'
  'xdg-desktop-portal-hyprland'
)

makedepends=('git')

source=(
  "omarchy::git+https://github.com/basecamp/omarchy.git#commit=${_commit}"
  'ps4-disabled-commands.txt'
  'ps4-replaced-commands.txt'
  'omarchy-ps4-unsupported'
  'omarchy-ps4-status'
  'omarchy-ps4-chromium-software-rendering'
  'omarchy-launch-nautilus'
  'omarchy-launch-nautilus-cwd'
  'ps4-network-panel.patch'
  'ps4-sshd-firewall.patch'
)
sha256sums=(
  'SKIP'
  '2d07b6e3002c1e7063aa31e2661af0a2a440fe03bacb7e7062fdb081acf481d7'
  'a448d5e7c6013c6f029f4eb118f71f84125e3c4b37fe6b69686fdb3850c3cae9'
  '20997056023e8830f4e3fa3aa743590c52adda7b23375939a3ac3e42a3e31d59'
  '3a6a387d9826498a87f53fea8ecb1966a49bb5a366f54d5b0d2227854012f28a'
  '622c372b581119f4346ad19e2615e343f437506d5b65eadc7a9f6c5b8530dc58'
  '122db1123d9fe1f8c679b87b6b5f7c00316079d9f294deaff097324a38a77393'
  'd78a147033bef36e2167041b668a423d5544fb872bc497bf072081adf31807cf'
  '482a0698be408e38376ae50f1a555ff538546241eb6d7b0dd35862e10d42f46f'
  'a0dd0aca3a39203085ee4af6f2727b47b6c53966f99a1feb8de6d0c8c3b24fd6'
)

prepare() {
  cd "$srcdir/omarchy"

  git apply --check "$srcdir/ps4-network-panel.patch"
  git apply "$srcdir/ps4-network-panel.patch"
  git apply --check "$srcdir/ps4-sshd-firewall.patch"
  git apply "$srcdir/ps4-sshd-firewall.patch"
}

package() {
  cd "$srcdir/omarchy"

  install -d \
    "$pkgdir/usr/bin" \
    "$pkgdir/usr/lib/omarchy-ps4/upstream-bin" \
    "$pkgdir/usr/share/omarchy/bin"

  while IFS= read -r command; do
    [[ -z $command || $command == \#* ]] && continue
    [[ -f bin/$command ]] || {
      printf 'disabled command is absent upstream: %s\n' "$command" >&2
      return 1
    }
  done <"$srcdir/ps4-disabled-commands.txt"

  for binary in bin/*; do
    [[ -f $binary ]] || continue
    name=${binary##*/}
    install -Dm755 "$binary" "$pkgdir/usr/lib/omarchy-ps4/upstream-bin/$name"

    case "$name" in
      omarchy-debug|omarchy-debug-idle|omarchy-upload-log)
        continue
        ;;
    esac

    case "$name" in
      omarchy-launch-nautilus|omarchy-launch-nautilus-cwd)
        install -Dm755 "$srcdir/$name" "$pkgdir/usr/bin/$name"
        ;;
      omarchy-theme-bg-install|omarchy-install-gaming-retroarch)
        sed 's/nautilus/thunar/g' "$binary" >"$srcdir/$name.ps4"
        install -Dm755 "$srcdir/$name.ps4" "$pkgdir/usr/bin/$name"
        ;;
      *)
        if grep -Fxq "$name" "$srcdir/ps4-disabled-commands.txt"; then
          install -Dm755 "$srcdir/omarchy-ps4-unsupported" "$pkgdir/usr/bin/$name"
        else
          install -Dm755 "$binary" "$pkgdir/usr/bin/$name"
        fi
        ;;
    esac
    ln -s "/usr/bin/$name" "$pkgdir/usr/share/omarchy/bin/$name"
  done

  install -d "$pkgdir/usr/share/omarchy"
  cp -a install migrations shell themes "$pkgdir/usr/share/omarchy/"
  install -Dm644 version "$pkgdir/usr/share/omarchy/version"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  install -Dm644 "$srcdir/ps4-disabled-commands.txt" \
    "$pkgdir/usr/share/omarchy-ps4/disabled-commands.txt"
  install -Dm644 "$srcdir/ps4-replaced-commands.txt" \
    "$pkgdir/usr/share/omarchy-ps4/replaced-commands.txt"
  install -Dm755 "$srcdir/omarchy-ps4-status" "$pkgdir/usr/bin/omarchy-ps4-status"
  install -Dm755 "$srcdir/omarchy-ps4-chromium-software-rendering" \
    "$pkgdir/usr/bin/omarchy-ps4-chromium-software-rendering"
  printf '%s  %s\n' "$_probe_sha256" "$startdir/../../bin/omarchy-ps4-probe" | sha256sum -c -
  install -Dm755 "$startdir/../../bin/omarchy-ps4-probe" "$pkgdir/usr/bin/omarchy-ps4-probe"
  printf '%s\n' "$_commit" >"$pkgdir/usr/share/omarchy-ps4/upstream-commit"

  if compgen -G 'migrations/*.sh' >/dev/null; then
    install -d "$pkgdir/etc/skel/.local/state/omarchy/migrations"
    for migration in migrations/*.sh; do
      touch "$pkgdir/etc/skel/.local/state/omarchy/migrations/${migration##*/}"
    done
  fi
}
