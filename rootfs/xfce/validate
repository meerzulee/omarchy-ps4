#!/usr/bin/env bash

set -euo pipefail

required_commands=(
  omarchy-ps4-probe
  startxfce4
  lightdm
  NetworkManager
  eglinfo
  glxinfo
  vulkaninfo
  wpctl
)

for command_name in "${required_commands[@]}"; do
  command -v "$command_name" >/dev/null || {
    printf 'missing required command: %s\n' "$command_name" >&2
    exit 1
  }
done

[[ $(systemctl is-enabled NetworkManager.service) == 'enabled' ]]
[[ $(systemctl is-enabled lightdm.service) == 'enabled' ]]
[[ $(systemctl get-default) == 'graphical.target' ]]
[[ -x /etc/lightdm/Xsession ]]
[[ -r /etc/lightdm/lightdm.conf.d/20-omarchy-ps4.conf ]]
[[ -r /usr/share/xsessions/xfce.desktop ]]
[[ -r /etc/fstab ]]

xorg_device_config=/etc/X11/xorg.conf.d/20-omarchy-ps4-modesetting.conf
[[ -r "$xorg_device_config" ]]
grep -Eq '^[[:space:]]*Option[[:space:]]+"AccelMethod"[[:space:]]+"none"[[:space:]]*$' \
  "$xorg_device_config" || {
  printf '%s\n' 'PS4 Xorg recovery profile must disable glamor acceleration' >&2
  exit 1
}

if passwd --status root | grep -qv ' L '; then
  printf '%s\n' 'root account is not locked' >&2
  exit 1
fi

printf '%s\n' 'XFCE rootfs validation passed'
