#!/bin/sh

PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH

say() {
  [ "${OMARCHY_SPLASH:-0}" = 1 ] || printf '%s\n' "[omarchy-ps4-initramfs] $*"
  printf '%s\n' "[omarchy-ps4-initramfs] $*" > /dev/kmsg 2>/dev/null || true
}

SPLASH_PID=""
stop_splash() {
  [ -n "$SPLASH_PID" ] || return 0
  [ "${1:-complete}" != failed ] || : > /run/omarchy-splash.failed
  : > /run/omarchy-splash.stop
  wait "$SPLASH_PID" 2>/dev/null || true
  SPLASH_PID=""
}

rescue() {
  stop_splash failed
  say "$*"
  say "Dropping to a root rescue shell."
  exec /bin/sh
}

mount -t proc proc /proc || rescue "Could not mount proc."
mount -t sysfs sysfs /sys || rescue "Could not mount sysfs."
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
mkdir -p /run /newroot /dev/pts
mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run || rescue "Could not mount /run."
mount -t devpts devpts /dev/pts 2>/dev/null || true

printf '%s\n' /bin/mdev > /proc/sys/kernel/hotplug 2>/dev/null || true
mdev -s 2>/dev/null || true

ROOT_SPEC="LABEL=OMARCHY-PS4"
ROOT_FSTYPE="ext4"
OMARCHY_SPLASH=0
OMARCHY_INSTALL=""
OMARCHY_BUNDLE_SPEC="LABEL=PS4BOOT"
OMARCHY_ROOTFS_PATH="/omarchy-ps4/omarchy-ps4-rootfs.tar.zst"
OMARCHY_ALLOW_DEVELOPMENT_ROOTFS=0

kernel_command_line=$(cat /proc/cmdline)
for parameter in $kernel_command_line; do
  case "$parameter" in
    root=*) ROOT_SPEC=${parameter#root=} ;;
    rootfstype=*) ROOT_FSTYPE=${parameter#rootfstype=} ;;
    omarchy.splash=1) OMARCHY_SPLASH=1 ;;
    omarchy.install=*) OMARCHY_INSTALL=${parameter#omarchy.install=} ;;
    omarchy.bundle=*) OMARCHY_BUNDLE_SPEC=${parameter#omarchy.bundle=} ;;
    omarchy.rootfs=*) OMARCHY_ROOTFS_PATH=${parameter#omarchy.rootfs=} ;;
    omarchy.allow_development_rootfs=1) OMARCHY_ALLOW_DEVELOPMENT_ROOTFS=1 ;;
  esac
done

export OMARCHY_SPLASH OMARCHY_ROOT_SPEC="$ROOT_SPEC" OMARCHY_BUNDLE_SPEC OMARCHY_ROOTFS_PATH OMARCHY_ALLOW_DEVELOPMENT_ROOTFS

if [ "$OMARCHY_SPLASH" = 1 ] && [ -x /bin/omarchy-splash ]; then
  rm -f /run/omarchy-splash.stop /run/omarchy-splash.failed
  /bin/omarchy-splash >/dev/null 2>&1 &
  SPLASH_PID=$!
fi

say "Linux $(uname -r) reached the initramfs."
say "Command line: $(cat /proc/cmdline)"
if [ "$OMARCHY_INSTALL" = usb ]; then
  say "Starting verified external-USB installation."
  /install-rootfs || rescue "External-USB installation failed."
fi

say "Waiting for root filesystem $ROOT_SPEC ($ROOT_FSTYPE)."

ROOT_DEVICE=$(cat /run/ps4-root-device 2>/dev/null || true)
attempt=0
while [ "$attempt" -lt 60 ]; do
  mdev -s 2>/dev/null || true

  case "$ROOT_SPEC" in
    LABEL=*|UUID=*|PARTUUID=*)
      ROOT_DEVICE=$(findfs "$ROOT_SPEC" 2>/dev/null || true)
      ;;
    /dev/*)
      [ -b "$ROOT_SPEC" ] && ROOT_DEVICE=$ROOT_SPEC
      ;;
  esac

  [ -n "$ROOT_DEVICE" ] && [ -b "$ROOT_DEVICE" ] && break
  attempt=$((attempt + 1))
  sleep 1
done

if [ -z "$ROOT_DEVICE" ] || [ ! -b "$ROOT_DEVICE" ]; then
  say "Available block filesystems:"
  blkid 2>/dev/null || true
  rescue "Root filesystem $ROOT_SPEC was not found after 60 seconds."
fi

say "Resolved $ROOT_SPEC to $ROOT_DEVICE."
if [ ! -e /newroot/etc/os-release ]; then
  mount -t "$ROOT_FSTYPE" -o rw "$ROOT_DEVICE" /newroot || rescue "Could not mount $ROOT_DEVICE."
fi

if [ ! -e /newroot/etc/os-release ] || [ ! -x /newroot/sbin/init ]; then
  umount /newroot 2>/dev/null || true
  rescue "$ROOT_DEVICE does not contain the expected Linux root filesystem."
fi

printf '%s\n' "$ROOT_DEVICE" > /run/ps4-root-device
say "Root filesystem validated; starting systemd."
stop_splash

mkdir -p /newroot/dev /newroot/proc /newroot/sys /newroot/run
mount --move /dev /newroot/dev || rescue "Could not move /dev."
mount --move /proc /newroot/proc || rescue "Could not move /proc."
mount --move /sys /newroot/sys || rescue "Could not move /sys."
mount --move /run /newroot/run || rescue "Could not move /run."

exec switch_root /newroot /sbin/init
