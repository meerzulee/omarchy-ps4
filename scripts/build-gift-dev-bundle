#!/usr/bin/env bash

set -euo pipefail

usage() {
  printf '%s\n' \
    'Usage: build-gift-dev-bundle [--output DIRECTORY]' \
    '' \
    'Assemble the private Quattro 4.0.0 developer gift bundle.'
}

fail() {
  printf 'build-gift-dev-bundle: %s\n' "$1" >&2
  exit 2
}

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repo_dir=$(cd -- "$script_dir/.." && pwd)
output=''

while (( $# > 0 )); do
  case "$1" in
    --output)
      (( $# >= 2 )) || fail '--output requires a directory'
      output=$2
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *) fail "unknown argument: $1" ;;
  esac
done

output=${output:-"$repo_dir/output/gift-dev/omarchy-ps4-gift-dev-4.0.0"}
[[ ! -e $output ]] || fail "output already exists: $output"

package_source=$repo_dir/output/omarchy-packages-4.0.0-stable-dev
snapshot_repository=$repo_dir/output/package-snapshot/omarchy-ps4-4.0.0-dev/repo
portable_source=$repo_dir/output/portable/omarchy-ps4-portable-4.0.0-f002044.tar.zst
fpkg_source=$repo_dir/output/fpkg-ui-prototype/IV0000-OMCH42069_00-OMARCHYPS4UI0000.pkg

declare -A expected_hashes=(
  [omarchy-ps4-4.0.0-1-any.pkg.tar.zst]=a4d994f25e978895fc8ce9665b0de55774445650a7de8fbd8e900090e7dccca0
  [omarchy-ps4-settings-4.0.0-1-any.pkg.tar.zst]=91dd1881c1588652a512c1399a8a89988a0b003ebb41c2f62f372f40c32bba19
  [omarchy-ps4-provisioning-4.0.0-1-any.pkg.tar.zst]=2263cff92cb348ef3e4ebb65a0959013dba1f536a78004373da5cfbd35ca0bab
  [desktop-file-utils-0.28-1-x86_64.pkg.tar.zst]=cc525a69b6901318f360fae249986e62f233c0320c61274f2bad44449e0c8e44
  [xdg-user-dirs-0.20-1-x86_64.pkg.tar.zst]=d2d8d9cf22fca76652320c905056dfcf55201665d025ae2c3de60702a36bfa65
  [xdg-utils-1.2.1-2-any.pkg.tar.zst]=35de6314be9c3c95e1e6bb6ecde5ceb2d9efb8412c0f154cd309eb9dcb16ebd7
  [omarchy-ps4-portable-4.0.0-f002044.tar.zst]=4df6e6158855a65bf290a12d3499304a1c950655e3ea66b7e7167b13f2887fab
)

for name in "${!expected_hashes[@]}"; do
  if [[ $name == omarchy-ps4-portable-* ]]; then
    source_path=$portable_source
  elif [[ -f $package_source/$name ]]; then
    source_path=$package_source/$name
  else
    source_path=$snapshot_repository/$name
  fi
  [[ -f $source_path ]] || fail "missing artifact: $source_path"
  actual=$(shasum -a 256 "$source_path" | awk '{ print $1 }')
  [[ $actual == "${expected_hashes[$name]}" ]] || \
    fail "hash mismatch for $name: $actual"
done
[[ -f $fpkg_source ]] || fail "missing UI-only FPKG: $fpkg_source"

command -v docker >/dev/null 2>&1 || fail 'Docker CLI is not installed'
[[ $(docker context show) == orbstack ]] || fail 'Docker context must be orbstack'
docker info >/dev/null 2>&1 || fail 'OrbStack Docker engine is not running'

mkdir -p \
  "$output/packages" \
  "$output/portable" \
  "$output/fpkg" \
  "$output/docs" \
  "$output/licenses"

cp "$package_source"/*.pkg.tar.zst "$output/packages/"
cp \
  "$snapshot_repository/desktop-file-utils-0.28-1-x86_64.pkg.tar.zst" \
  "$snapshot_repository/xdg-user-dirs-0.20-1-x86_64.pkg.tar.zst" \
  "$snapshot_repository/xdg-utils-1.2.1-2-any.pkg.tar.zst" \
  "$output/packages/"
cp "$portable_source" "$output/portable/"
cp "$portable_source.sha256" "$output/portable/"
cp "$fpkg_source" "$output/fpkg/"
cp "$repo_dir/gift-dev/README.md" "$output/README.md"
cp "$repo_dir/gift-dev/check" "$output/check"
cp "$repo_dir/gift-dev/arm-recovery" "$output/arm-recovery"
cp "$repo_dir/gift-dev/dev-recovery" "$output/dev-recovery"
cp "$repo_dir/gift-dev/install-foundation" "$output/install-foundation"
cp "$repo_dir/gift-dev/owner-rehearsal" "$output/owner-rehearsal"
cp "$repo_dir/gift-dev/owner-rehearsal.service" "$output/owner-rehearsal.service"
chmod 0755 \
  "$output/check" \
  "$output/arm-recovery" \
  "$output/dev-recovery" \
  "$output/install-foundation" \
  "$output/owner-rehearsal"
cp "$repo_dir/docs/QUATTRO-4.0.md" "$output/docs/"
cp "$repo_dir/docs/GIFT-DEV-VM-TEST-2026-08-14.md" "$output/docs/"
cp "$repo_dir/fpkg/docs/UI-PROTOTYPE.md" "$output/docs/"
cp "$repo_dir/fpkg/CREDITS.md" "$output/docs/"
cp "$repo_dir/fpkg/THIRD_PARTY.md" "$output/docs/"
cp "$repo_dir/cache/omarchy-quattro/LICENSE" "$output/licenses/Omarchy-MIT.txt"

toolchain_dir=$repo_dir/cache/openorbis-v0.5.4/OpenOrbis/PS4Toolchain
[[ -f $toolchain_dir/LICENSE ]] || fail 'verified OpenOrbis license source is missing'
cp "$toolchain_dir/LICENSE" "$output/licenses/OpenOrbis-GPL-3.0.txt"
cp "$toolchain_dir/bin/macos/LICENSE.txt" "$output/licenses/LibOrbisPkg-LGPL-3.0.txt"
cp "$toolchain_dir/samples/font/assets/fonts/OFL.txt" "$output/licenses/Gontserrat-OFL-1.1.txt"

docker run --rm --platform linux/amd64 \
  -v "$output/packages:/packages" \
  -w /packages \
  archlinux:base \
  bash -lc '
    set -euo pipefail
    repo-add omarchy-ps4-dev.db.tar.gz ./*.pkg.tar.zst
    normalized=$(mktemp -d)
    bsdtar -xf omarchy-ps4-dev.db.tar.gz -C "$normalized"
    find "$normalized" -exec touch -h -d @1786233600 {} +
    (
      cd "$normalized"
      find . -mindepth 1 -maxdepth 1 -type d -printf "%P\0" |
        LC_ALL=C sort -z |
        tar --null --files-from=- --sort=name --mtime=@1786233600 \
          --owner=0 --group=0 --numeric-owner -cf -
    ) | gzip -n >omarchy-ps4-dev.db.tar.gz.normalized
    mv omarchy-ps4-dev.db.tar.gz.normalized omarchy-ps4-dev.db.tar.gz
  ' >/dev/null

database_target=$(readlink "$output/packages/omarchy-ps4-dev.db")
[[ -n $database_target && -f $output/packages/$database_target ]] || \
  fail 'repo-add did not create the expected database'
cp "$output/packages/$database_target" "$output/packages/omarchy-ps4-dev.db.regular"
rm "$output/packages/omarchy-ps4-dev.db"
mv "$output/packages/omarchy-ps4-dev.db.regular" "$output/packages/omarchy-ps4-dev.db"
rm -f "$output/packages/omarchy-ps4-dev.files" "$output/packages/omarchy-ps4-dev.files.tar.gz"

cat >"$output/BUNDLE.env" <<EOF
schema=1
mode=gift-dev-offline-foundation-migration
release=4.0.0
upstream_commit=f0020448ca87329199de7cb12f2015ebc4a3e5e7
native_package_count=3
migration_support_package_count=3
ui_fpkg_content_id=IV0000-OMCH42069_00-OMARCHYPS4UI0000
gift_finalization=offline-cloned-root-only
temporary_recovery=required-before-foundation-install
recoverable_owner_rehearsal=available-in-development-mode
EOF

manifest_temporary=$(mktemp "${TMPDIR:-/tmp}/omarchy-gift-manifest.XXXXXX")
(
  cd "$output"
  find . -type f ! -name MANIFEST.sha256 -print0 |
    LC_ALL=C sort -z |
    xargs -0 shasum -a 256
) >"$manifest_temporary"
mv "$manifest_temporary" "$output/MANIFEST.sha256"

(cd "$output" && ./check >/dev/null)

archive=$output.tar.zst
COPYFILE_DISABLE=1 bsdtar -acf "$archive" -C "$(dirname -- "$output")" "$(basename -- "$output")"
printf 'Gift developer bundle: %s\n' "$output"
printf 'Archive: %s\n' "$archive"
shasum -a 256 "$archive"
