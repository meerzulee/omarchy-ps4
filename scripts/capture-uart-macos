#!/usr/bin/env bash

set -euo pipefail

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly REPO_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
readonly BAUD="${PS4_UART_BAUD:-115200}"
readonly LOG_DIR="${PS4_UART_LOG_DIR:-${REPO_DIR}/experiments/uart}"

device="${1:-${PS4_UART_DEVICE:-}}"

if [[ -z "${device}" ]]; then
  candidates=()
  for candidate in \
    /dev/cu.usbserial* \
    /dev/cu.wchusbserial* \
    /dev/cu.SLAB_USBtoUART* \
    /dev/cu.usbmodem*; do
    [[ -c "${candidate}" ]] && candidates+=("${candidate}")
  done

  if (( ${#candidates[@]} != 1 )); then
    printf '%s\n' 'error: could not identify exactly one USB UART device' >&2
    printf '%s\n' 'Pass it explicitly, for example:' >&2
    printf '  %s /dev/cu.usbserial-DEVICE\n' "$0" >&2
    printf '%s\n' 'Current serial devices:' >&2
    find /dev -maxdepth 1 -type c -name 'cu.*' -print 2>/dev/null | sort >&2
    exit 1
  fi

  device=${candidates[0]}
fi

if [[ ! -c "${device}" ]]; then
  printf 'error: not a serial character device: %s\n' "${device}" >&2
  exit 1
fi

if ! command -v picocom >/dev/null 2>&1; then
  printf '%s\n' 'error: picocom is required' >&2
  exit 1
fi

mkdir -p "${LOG_DIR}"
readonly TIMESTAMP="$(date -u '+%Y%m%dT%H%M%SZ')"
readonly LOG_FILE="${LOG_DIR}/${TIMESTAMP}-linux-6.18.44-xfce-cold-boot.log"

printf 'UART device: %s\n' "${device}"
printf 'UART format: %s 8N1\n' "${BAUD}"
printf 'Log file:    %s\n' "${LOG_FILE}"
printf '%s\n' 'Exit picocom with Control-A, then Control-X.'

exec picocom \
  --baud "${BAUD}" \
  --databits 8 \
  --parity n \
  --stopbits 1 \
  --flow n \
  --logfile "${LOG_FILE}" \
  "${device}"
