#!/usr/bin/env python3

from __future__ import annotations

import argparse
import subprocess
import sys
from pathlib import Path


PROJECT = Path(__file__).resolve().parents[1]
UPSTREAM = PROJECT / "cache/omarchy-quattro"
LOCK = PROJECT / "upstream/omarchy.lock"
PROFILE = PROJECT / "profiles/omarchy-full"
OUTPUT = PROFILE / "packages.txt"


def fail(message: str) -> None:
    raise SystemExit(f"error: {message}")


def read_lock() -> dict[str, str]:
    values: dict[str, str] = {}
    for raw in LOCK.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        key, separator, value = line.partition("=")
        if not separator:
            fail(f"invalid lock line: {raw}")
        values[key] = value
    return values


def package_lines(path: Path) -> list[str]:
    packages: list[str] = []
    for raw in path.read_text().splitlines():
        line = raw.split("#", 1)[0].strip()
        if line:
            packages.append(line)
    return packages


def render() -> str:
    lock = read_lock()
    commit = lock.get("OMARCHY_COMMIT", "")
    if len(commit) != 40:
        fail("upstream lock has no full OMARCHY_COMMIT")

    if not (UPSTREAM / ".git").exists():
        fail("upstream checkout is missing; run ./scripts/sync-omarchy-upstream")

    actual_commit = subprocess.check_output(
        ["git", "-C", str(UPSTREAM), "rev-parse", "HEAD"], text=True
    ).strip()
    if actual_commit != commit:
        fail(f"upstream checkout is {actual_commit}, expected {commit}")

    upstream_packages = package_lines(UPSTREAM / "install/omarchy-base.packages")
    blocked_packages = package_lines(PROFILE / "blocked-packages.txt")
    additional_packages = package_lines(PROFILE / "additional-packages.txt")

    duplicates = sorted(
        package for package in set(upstream_packages) if upstream_packages.count(package) > 1
    )
    if duplicates:
        fail(f"upstream package list contains duplicates: {', '.join(duplicates)}")

    unknown_blocked = sorted(set(blocked_packages) - set(upstream_packages))
    if unknown_blocked:
        fail(f"blocked packages are absent upstream: {', '.join(unknown_blocked)}")

    included_upstream = [
        package for package in upstream_packages if package not in set(blocked_packages)
    ]
    overlap = sorted(set(included_upstream) & set(additional_packages))
    if overlap:
        fail(f"additional packages duplicate upstream packages: {', '.join(overlap)}")

    packages = additional_packages + included_upstream
    if len(packages) != len(set(packages)):
        fail("composed package list contains duplicates")

    header = [
        "# Generated by scripts/compose-omarchy-full-profile; do not edit directly.",
        f"# Upstream Quattro commit: {commit}",
        f"# Upstream packages: {len(upstream_packages)}",
        f"# PS4-blocked upstream packages: {len(blocked_packages)}",
        f"# PS4/additional packages: {len(additional_packages)}",
        f"# Final package count: {len(packages)}",
        "",
    ]
    return "\n".join(header + packages) + "\n"


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Compose the pinned full Omarchy PS4 package profile."
    )
    parser.add_argument(
        "--check", action="store_true", help="fail if the committed output is stale"
    )
    args = parser.parse_args()

    expected = render()
    if args.check:
        if not OUTPUT.exists():
            fail(f"generated profile is missing: {OUTPUT}")
        if OUTPUT.read_text() != expected:
            fail("profiles/omarchy-full/packages.txt is stale; regenerate it")
        print(f"Full profile is current: {OUTPUT}")
        return 0

    OUTPUT.write_text(expected)
    package_count = sum(
        1 for line in expected.splitlines() if line and not line.startswith("#")
    )
    print(f"Wrote {package_count} packages to {OUTPUT}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
